# =============================================================================
# STARIST - Environment Variables Example
# =============================================================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# -----------------------------------------------------------------------------
# Model Configuration
# -----------------------------------------------------------------------------
# Allow users to download additional NER models from the UI
# Set to "true" to enable, or remove/comment out to disable
ALLOW_OTHER_MODELS=false

# -----------------------------------------------------------------------------
# Azure Text Analytics (Optional)
# -----------------------------------------------------------------------------
# If using Azure Text Analytics for entity recognition
# TA_KEY=your_azure_text_analytics_key
# TA_ENDPOINT=https://your-resource.cognitiveservices.azure.com/

# -----------------------------------------------------------------------------
# OpenAI Integration (Optional)
# -----------------------------------------------------------------------------
# For synthetic data generation features
# OPENAI_TYPE=Azure  # Options: "Azure" or "openai"
# OPENAI_KEY=your_openai_api_key
# OPENAI_API_VERSION=2023-05-15
# AZURE_OPENAI_ENDPOINT=https://your-openai-resource.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=gpt-4
