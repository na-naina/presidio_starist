# =============================================================================
# STARIST - Git Ignore
# =============================================================================

# Python virtual environments
presidio-venv/
venv/
.venv/
env/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Poetry lock (regenerate with poetry install)
poetry.lock

# PyInstaller
*.spec

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# VS Code settings (optional - remove if you want to share settings)
.vscode/

# IDE settings
.idea/
*.swp
*.swo

# OS-specific
.DS_Store
Thumbs.db
Desktop.ini

# Streamlit cache
.streamlit/

# Environment variables (contains secrets)
.env

# Logs
*.log
logs/

# Temporary files
tmp/
temp/
*.tmp

# Model cache (large files, will be downloaded on first run)
.cache/
~/.flair/
~/.cache/huggingface/

# Backup folder
Backup/